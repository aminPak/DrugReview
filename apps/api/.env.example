# Copy to .env for local development.
PORT=8787
# Comma-separated browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:3000,http://localhost:8081

# Admin area (website /admin). Leave empty to switch it off. Use a long random string, at least
# 24 characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Where admin settings are saved (default: ./data, which is not committed).
DATA_DIR=data
# Optional: an AI key can also be set here instead of on the admin page.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
